#include <iostream>
#include <cmath>

using namespace std;

int main(){
    float area,lado1,lado2,lado3,s, sqrt ;
    cout<<"Ingresa el lado1: " ;
    cin>>lado1 ;
    cout<<"Ingresa el lado2:  " ;
    cin>>lado2 ;
    cout<<"Ingresa el lado3:  " ;
    cin>>lado3 ;
    s=(lado1+lado2+lado3)/2 ;
    area = sqrt*(s*(s-lado1)*(s-lado2)*(s-lado3)) ;
    cout<<"El area es: "<<area ;
    

    return 0;
}
